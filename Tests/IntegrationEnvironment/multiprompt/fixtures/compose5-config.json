{
  "name": "openlxssh-mina-preflight",
  "networks": {
    "multiprompt-private": {
      "name": "openlxssh-mina-preflight_multiprompt-private",
      "ipam": {},
      "internal": true,
      "labels": {
        "org.openlxssh.fixture": "auth-mina-fixture-a"
      }
    }
  },
  "services": {
    "multiprompt": {
      "restart": "no",
      "cap_drop": [
        "ALL"
      ],
      "cpus": 0.5,
      "command": null,
      "entrypoint": null,
      "image": "openlxssh-auth-mina-fixture:2.20.0-arm64",
      "init": true,
      "labels": {
        "org.openlxssh.fixture": "auth-mina-fixture-a"
      },
      "logging": {
        "driver": "none"
      },
      "mem_limit": "536870912",
      "memswap_limit": "536870912",
      "networks": {
        "multiprompt-private": null
      },
      "pids_limit": 128,
      "platform": "linux/arm64",
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "stop_grace_period": "5s",
      "tmpfs": [
        "/run/openlxssh-multiprompt:rw,nosuid,nodev,noexec,size=16m,mode=0700,uid=10000,gid=10000",
        "/tmp:rw,nosuid,nodev,noexec,size=32m,mode=1777"
      ],
      "ulimits": {
        "core": {},
        "nofile": {
          "soft": 1024,
          "hard": 1024
        }
      },
      "user": "10000:10000",
      "build": {
        "context": "/Users/liuwenshuo/Desktop/OpenLXSSH/Tests/IntegrationEnvironment/multiprompt",
        "dockerfile": "Dockerfile"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python3",
          "/opt/multiprompt/control.py",
          "health",
          "--authorized-run"
        ],
        "timeout": "3s",
        "interval": "10s",
        "retries": 3,
        "start_period": "30s"
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 2222,
          "published": "22225",
          "protocol": "tcp"
        }
      ]
    }
  }
}
