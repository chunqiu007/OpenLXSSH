# No Include: never consume distro or host SSH defaults.
Port 2222
ListenAddress 0.0.0.0
HostKey /run/openlxssh-fixture/current/host_ed25519
PidFile /run/openlxssh-fixture/sshd.pid
AllowUsers fixture
PermitRootLogin no
PermitEmptyPasswords no
UsePAM yes
StrictModes yes
AuthorizedKeysFile /run/openlxssh-fixture/authorized_keys
PubkeyAuthentication @PUBKEY@
HostbasedAuthentication no
GSSAPIAuthentication no
PasswordAuthentication @PASSWORD@
KbdInteractiveAuthentication @KBD@
AuthenticationMethods @METHODS@
MaxAuthTries 3
LoginGraceTime 90
MaxStartups 8:30:16
MaxSessions 8
PermitUserEnvironment no
PermitUserRC no
AllowAgentForwarding no
AllowTcpForwarding no
AllowStreamLocalForwarding no
DisableForwarding yes
X11Forwarding no
PermitTunnel no
GatewayPorts no
UseDNS no
PrintMotd no
PrintLastLog no
LogLevel ERROR
# Fixed Ubuntu openssh-sftp-server package path, no shell-derived arguments.
Subsystem sftp /usr/lib/openssh/sftp-server
